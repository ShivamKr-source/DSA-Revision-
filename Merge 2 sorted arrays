class Solution {

    /*
     * Problem:
     * Merge nums2 into nums1 as one sorted array.
     *
     * Important constraints:
     * - nums1 has size (m + n)
     * - First m elements of nums1 are valid
     * - Last n elements of nums1 are empty (0 placeholders)
     * - nums2 has n valid elements
     *
     * Key Insight:
     * - Merge from RIGHT to LEFT to avoid overwriting elements in nums1.
     */

    public void merge(int[] nums1, int m, int[] nums2, int n) {

        // Pointer i → last valid element in nums1
        int i = m - 1;

        // Pointer j → last element in nums2
        int j = n - 1;

        // Pointer k → last index of nums1 (where we place elements)
        int k = m + n - 1;

        /*
         * Merge while both arrays still have elements.
         * We always place the larger of nums1[i] and nums2[j]
         * at position k, then move backwards.
         */
        while (i >= 0 && j >= 0) {

            if (nums1[i] > nums2[j]) {
                nums1[k] = nums1[i]; // place larger element
                i--;                 // move nums1 pointer
            } else {
                nums1[k] = nums2[j]; // place larger element
                j--;                 // move nums2 pointer
            }

            k--; // move placement pointer
        }

        /*
         * If nums2 still has remaining elements,
         * copy them into nums1.
         *
         * Note:
         * We do NOT need to copy remaining nums1 elements
         * because they are already in the correct position.
         */
        while (j >= 0) {
            nums1[k] = nums2[j];
            j--;
            k--;
        }
    }
}
