Given an integer array nums, rotate the array to the right by k steps, where k is non-negative.

Example 1:

Input: nums = [1,2,3,4,5,6,7], k = 3
Output: [5,6,7,1,2,3,4]
Explanation:
rotate 1 steps to the right: [7,1,2,3,4,5,6]
rotate 2 steps to the right: [6,7,1,2,3,4,5]
rotate 3 steps to the right: [5,6,7,1,2,3,4]


class Solution {

    public void rotate(int[] nums, int k) {

        // Step 1: If k is greater than array length,
        // rotating more than n times is redundant.
        // So we reduce k using modulo.
        k = k % nums.length;

        // Step 2: Reverse the entire array
        // Example: [1,2,3,4,5,6,7] → [7,6,5,4,3,2,1]
        reverse(nums, 0, nums.length - 1);

        // Step 3: Reverse the first k elements
        // This puts the rotated part in correct order
        // Example (k=3): [7,6,5,4,3,2,1] → [5,6,7,4,3,2,1]
        reverse(nums, 0, k - 1);

        // Step 4: Reverse the remaining elements (from k to end)
        // This restores order for the left-over part
        // Example: [5,6,7,4,3,2,1] → [5,6,7,1,2,3,4]
        reverse(nums, k, nums.length - 1);
    }

    // Helper function to reverse elements between index start and end
    public void reverse(int[] nums, int start, int end) {

        // Swap elements from both ends moving inward
        while (start < end) {

            // Temporary variable to hold one value during swap
            int temp = nums[start];

            // Swap start and end values
            nums[start] = nums[end];
            nums[end] = temp;

            // Move pointers inward
            start++;
            end--;
        }
    }
}
